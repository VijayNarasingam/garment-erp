# Copy to .env before running docker compose.
# JWT_SECRET is required in production: use at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-secret

CORS_ORIGINS=http://localhost:8088

DB_NAME=garment_erp
DB_USER=garment
DB_PASSWORD=garment
DB_ROOT_PASSWORD=root

# First-run bootstrap owner (password is only used when the business is created).
BOOTSTRAP_BUSINESS_NAME=My Garment Store
BOOTSTRAP_ADMIN_USERNAME=owner
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_NAME=Business Owner
SEED_PASSWORD=Retail@123

FRONTEND_PORT=8088
BACKEND_PORT=8080
DB_PORT=3306
